# Copy to .env (chmod 600) and edit. Never commit .env.
COMPOSE_PROJECT_NAME=autonomous-deception

# Ubuntu VM addresses (examples from docs/PROJECT_CONTEXT.md - verify with `ip -br addr`)
COWRIE_BIND_IP=10.77.10.10
DASHBOARD_BIND_IP=10.77.20.10

APP_ENV=development

# Image names MUST be lowercase.
AI_CORE_IMAGE=autonomous-deception/ai-core:dev
CONTROLLER_IMAGE=autonomous-deception/controller:dev
DASHBOARD_IMAGE=autonomous-deception/dashboard:dev

# Runtime user for ai-core; must own ./data/app/db and ./data/app/state (see `id`).
AI_CORE_UID=1000
AI_CORE_GID=1000

# Phase 8 classifier (read by ai_core.classifier; MODEL_DIR is set in compose.yaml)
# Pin the deployed checkpoint: loading fails if the file's SHA-256 differs.
MODEL_SHA256=d2087f59d336150ac07d4a10903862a0467d53f56b6699d21d4199a261bb9ee1
